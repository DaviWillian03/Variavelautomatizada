# Copie este arquivo para .env (o executar.bat faz isso sozinho) e ajuste se precisar.
# NÃO coloque usuário, senha nem códigos do Authenticator aqui: o login é sempre feito por você.

URL_SISTEMA=https://broker3.flagcloud.com.br/login
HOST_SISTEMA=connectmerchan.flagcloud.com.br

# chrome (padrão) | msedge | chromium
NAVEGADOR=chrome

# Lista de colaboradores (colunas: Cod. Colaborador, Nome, Usuario, Nome Superior)
PLANILHA=colaboradores.xlsx

# Deixe vazio para usar a Área de Trabalho do Windows (inclusive no OneDrive)
PASTA_AREA_TRABALHO=

# Tempo máximo esperando cada caderno PDF ficar pronto no painel Relatórios (segundos)
TIMEOUT_RELATORIO_S=300
TIMEOUT_MS=30000
